# Copy this file to .env for local development. Replace the example credentials.
# Keep this password and the password in DATABASE_URL in sync.
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://quick_notes:change-me@127.0.0.1:5432/quick_notes

# Generate a persistent secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-a-random-secret

# Use the browser-facing origin, including scheme and any non-default port.
# Set it explicitly to your public HTTPS origin in production.
APP_ORIGIN=http://localhost:3000

# Use 0.0.0.0 when running the app in a container.
# Your hosting platform may supply PORT automatically.
HOST=127.0.0.1
PORT=3000

# Optional. Set only when your reverse proxy overwrites this client-IP header.
# Leave blank to use a shared rate-limit bucket.
TRUSTED_CLIENT_IP_HEADER=
