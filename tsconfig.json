{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client", "vite-plugin-pwa/client"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["apps", "packages", "tests", "*.ts"]
}
